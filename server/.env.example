NODE_ENV=
PORT=
MONGODB_URI=
MONGO_MAX_POOL_SIZE=
JWT_SECRET=
# Session length. A device in regular use is renewed automatically and never
# signed out; one left idle for this long has to sign in again.
JWT_EXPIRES_IN=10d
# Renew a session once its token is older than this many seconds.
JWT_RENEW_AFTER_SECONDS=86400
DEBUG_GOOGLE_AUTH=false
ADMIN_EMAILS=
DISABLE_ANALYTICS=false
CLIENT_URL=
APP_URL=
CORS_ORIGINS=
VERCEL_PREVIEW_ORIGINS=
GOOGLE_CLIENT_ID=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ENABLE_BUG_REPORTS=
ENABLE_BUG_REPORT_EMAILS=
BUG_REPORT_NOTIFY_EMAIL=
ENABLE_GITHUB_BUG_ISSUES=
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
STREAM_API_KEY=
STREAM_API_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
