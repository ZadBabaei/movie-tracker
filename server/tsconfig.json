{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": false
  },
  "include": [
    "index.ts",
    "socket.ts",
    "models/**/*.ts",
    "routes/**/*.ts",
    "middleware/**/*.ts",
    "utils/**/*.ts",
    "types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "ts-node": {
    "files": true
  }
}
